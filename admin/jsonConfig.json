{
  "type": "panel",
  "items": {
    "_channelNotice1": {
      "type": "staticText",
      "text": "Die Channel-Verwaltung liegt jetzt im eigenen Admin-Bereich \"Firebase Sync\" links im Adapter."
    },
    "_channelNotice2": {
      "type": "staticText",
      "text": "In den Instanz-Einstellungen bleiben nur globale Firebase- und Laufzeitwerte."
    },
    "databaseUrl": {
      "type": "text",
      "label": "Firebase RTDB URL",
      "sm": 12,
      "validator": "data.databaseUrl || 'Firebase RTDB URL is required'"
    },
    "rootPath": {
      "type": "text",
      "label": "Root path",
      "sm": 12,
      "default": "home"
    },
    "serviceAccountJson": {
      "type": "password",
      "label": "Service Account JSON",
      "sm": 12
    },
    "dryRun": {
      "type": "checkbox",
      "label": "Dry run - log writes without sending to Firebase",
      "sm": 12,
      "default": true
    },
    "dailyWriteHour": {
      "type": "number",
      "label": "Daily write hour",
      "min": 0,
      "max": 23,
      "sm": 6
    },
    "dailyWriteMinute": {
      "type": "number",
      "label": "Daily write minute",
      "min": 0,
      "max": 59,
      "sm": 6
    }
  }
}
