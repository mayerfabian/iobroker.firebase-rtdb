{
  "common": {
    "name": "firebase-history-sync",
    "version": "0.0.3",
    "news": {
      "0.0.3": {
        "en": "Added a dedicated Firebase Sync admin tab and removed auto-filled default channels from instance storage.",
        "de": "Eigener Firebase-Sync-Admin-Tab hinzugefuegt und automatisch vorbefuellte Standard-Channels aus der Instanzspeicherung entfernt."
      },
      "0.0.2": {
        "en": "Added custom object icon integration and improved admin metadata for object-level selection.",
        "de": "Custom-Objekt-Icon-Integration und Admin-Metadaten fuer objektbezogene Auswahl verbessert."
      },
      "0.0.1": {
        "en": "Initial MVP scaffold with Firebase RTDB current and history sync.",
        "de": "Initiales MVP-Grundgeruest mit Firebase RTDB Current- und History-Sync."
      }
    },
    "titleLang": {
      "en": "Firebase RTDB History Sync",
      "de": "Firebase RTDB History Sync"
    },
    "desc": {
      "en": "Collects selected ioBroker states, throttles writes, and syncs current and history data to Firebase Realtime Database.",
      "de": "Sammelt ausgewaehlte ioBroker States, drosselt Writes und synchronisiert Current- und History-Daten in Firebase Realtime Database."
    },
    "authors": [
      "Fabian Mayer"
    ],
    "keywords": [
      "firebase",
      "rtdb",
      "history",
      "sync"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "main": "build/main.js",
    "icon": "firebase-history-sync.svg",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/fabianmayer/iobroker.firebase-history-sync/main/admin/firebase-history-sync.svg",
    "readme": "https://github.com/fabianmayer/iobroker.firebase-history-sync/blob/main/README.md",
    "loglevel": "info",
    "mode": "daemon",
    "type": "general",
    "supportCustoms": true,
    "messagebox": true,
    "adminTab": {
      "name": {
        "en": "Firebase Sync",
        "de": "Firebase Sync"
      },
      "ignoreConfigUpdate": true,
      "singleton": false,
      "fa-icon": "</i><img style='width:24px;margin-bottom:-6px;' src='/adapter/firebase-history-sync/firebase-history-sync.svg'><i>"
    },
    "compact": true,
    "connectionType": "cloud",
    "dataSource": "push",
    "adminUI": {
      "config": "json",
      "custom": "json",
      "tab": "materialize"
    },
    "materialize": true,
    "dependencies": [
      {
        "js-controller": ">=5.0.0"
      }
    ],
    "tier": 3,
    "restartAdapters": [],
    "installedFrom": "C:\\Users\\fabian.mayer\\Documents\\web\\iobroker.firebase-history-sync"
  },
  "native": {
    "databaseUrl": "",
    "rootPath": "home",
    "serviceAccountJson": "",
    "dryRun": true,
    "dailyWriteHour": 0,
    "dailyWriteMinute": 10,
    "channels": []
